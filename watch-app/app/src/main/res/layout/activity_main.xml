<?xml version="1.0" encoding="utf-8"?>
<!-- Round-display aware layout for Xiaomi Watch 5.
     480x480 px at 320dpi means the usable width is only 240dp, so every
     horizontal row has to stay narrow: the composer is stacked as
     [text field] on one row and [mic | send] on the next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <!-- Chat transcript, padded away from the circular edge -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="126dp"
        android:clipToPadding="false"
        android:paddingHorizontal="28dp"
        android:paddingTop="44dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Status text, kept inside the top arc -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingHorizontal="52dp"
        android:text="@string/disconnected"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Composer: two rows so nothing is squeezed below one character -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_dark"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="22dp"
        android:paddingTop="4dp">

        <!-- Row 1: optional typing, deliberately compact — voice is the main
             path on a 240dp round display. -->
        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/input_bg"
            android:gravity="center_vertical"
            android:hint="@string/hint_type"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Row 2: voice first. The talk pill takes every spare dp; send is a
             small circular arrow because typing is the rare path on a 240dp
             round screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Hold-to-talk: the pill turns red and swaps the glyph for an
                 animated waveform while recording; a spinner replaces both
                 while the recorder is still being armed. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/micButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/talk_bg"
                    android:contentDescription="@string/hint_speak"
                    android:paddingHorizontal="40dp"
                    android:paddingVertical="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic" />

                <ProgressBar
                    android:id="@+id/micSpinner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/text_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/send_bg"
                android:contentDescription="@string/send"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
